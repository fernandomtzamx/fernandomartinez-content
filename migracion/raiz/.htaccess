# .htaccess de la RAÍZ de www.fernandomartinez.mx
# 1) Redirecciones 301 del sitio Joomla anterior (98 URLs viejas).
# 2) Bloque estándar de WordPress (WordPress puede reescribir solo ese bloque al guardar enlaces permanentes).

# Redirecciones 301 del sitio Joomla a WordPress (generado por scripts/redirects.py)
# Pegar ANTES de '# BEGIN WordPress' en el .htaccess de la raíz.
<IfModule mod_rewrite.c>
RewriteEngine On

# Variantes de Joomla: /index.php/ruta y feeds RSS (?format=feed)
RewriteRule ^index\.php/(.+)$ /$1 [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)format=feed
RewriteRule ^ /feed/? [R=301,L]

# Directorio de enlaces: el referido de Shopify conserva su destino exacto
RewriteCond %{QUERY_STRING} (^|&)task=weblink\.go.*(^|&)id=100([:&]|$)
RewriteRule ^(enlaces-recomendados|component/weblinks)/?$ https://shopify.pxf.io/prueba-gratis-shop? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)task=weblink\.go
RewriteRule ^(enlaces-recomendados|component/weblinks)/?$ /recursos/las-mejores-herramientas-de-seo-e-inbound-marketing/? [R=301,L]

# Paginación del blog y categorías de Joomla
RewriteCond %{QUERY_STRING} (^|&)start=
RewriteRule ^blog/?$ /blog/? [R=301,L]
RewriteRule ^temas/.+$ /blog/ [R=301,L]
RewriteRule ^enlaces-recomendados/.+$ /recursos/las-mejores-herramientas-de-seo-e-inbound-marketing/ [R=301,L]
RewriteRule ^component/tags/.*$ /blog/ [R=301,L]
RewriteRule ^recursos/imagenes-libres-de-derechos-gratis/.+$ /recursos/imagenes-libres-de-derechos-gratis/ [R=301,L]

# Entradas y páginas
RewriteRule ^base-de-conocimiento/?$ /recursos/ [R=301,L]
RewriteRule ^blog/12-entre-aportar-al-teleton-y-el-odio-a-televisa/?$ /blog/entre-aportar-al-teleton-y-el-odio-a-televisa/ [R=301,L]
RewriteRule ^blog/13-como-funciona-los-5-pilares-del-inbound-marketing/?$ /blog/como-funciona-los-5-pilares-del-inbound-marketing/ [R=301,L]
RewriteRule ^blog/14-que-es-el-inbound-marketing/?$ /blog/que-es-el-inbound-marketing/ [R=301,L]
RewriteRule ^blog/15-reducir-tiempo-carga-sitio-web-joomla/?$ /blog/reducir-tiempo-carga-sitio-web-joomla/ [R=301,L]
RewriteRule ^blog/16-para-que-sirve-un-blog-en-mi-sitio-web/?$ /blog/para-que-sirve-un-blog-en-mi-sitio-web/ [R=301,L]
