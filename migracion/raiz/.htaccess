RewriteRule ^blog/41-credito-automotriz-en-linea-disrupcion-venta-de-autos/?$ /blog/credito-automotriz-en-linea-disrupcion-venta-de-autos/ [R=301,L]
RewriteRule ^blog/5-activismo-con-hashtags/?$ /blog/activismo-con-hashtags/ [R=301,L]
RewriteRule ^blog/6-crear-lealtad-a-tu-marca-no-se-logra-solo-con-comunicacion/?$ /blog/crear-lealtad-a-tu-marca-no-se-logra-solo-con-comunicacion/ [R=301,L]
RewriteRule ^blog/7-manifiesto-de-marketing-digital-de-fernando-martinez/?$ /blog/manifiesto-de-marketing-digital-de-fernando-martinez/ [R=301,L]
RewriteRule ^blog/9-en-contra-de-la-tolerancia/?$ /blog/en-contra-de-la-tolerancia/ [R=301,L]
RewriteRule ^busqueda/?$ /blog/ [R=301,L]
RewriteRule ^enlaces-recomendados/?$ /recursos/las-mejores-herramientas-de-seo-e-inbound-marketing/ [R=301,L]
RewriteRule ^mapa-de-sitio/?$ / [R=301,L]
RewriteRule ^recursos/11-imagenes-libres-de-derechos-gratis/?$ /recursos/imagenes-libres-de-derechos-gratis/ [R=301,L]
RewriteRule ^temas/?$ /blog/ [R=301,L]
RewriteRule ^usuario/inicio-de-sesion/?$ / [R=301,L]
RewriteRule ^usuario/registro/?$ / [R=301,L]

# Archivos descargables que cambian de ruta (actualizar con la URL final de la biblioteca de medios)
# /media/weTnwLzC8MAT47xS/plg_websitepreloader.zip -> /recursos/website-preloader-joomla-plugin/
RewriteRule ^media/weTnwLzC8MAT47xS/plg_websitepreloader\.zip/?$ /recursos/website-preloader-joomla-plugin/ [R=301,L]
RewriteRule ^media/weTnwLzC8MAT47xS/plg_TwitterSummaryCardforArticles\.zip/?$ /recursos/twitter-summary-card-for-joomla-articles-plugin/ [R=301,L]
RewriteRule ^media/weTnwLzC8MAT47xS/25_cosas.*\.pdf/?$ /recursos/25-cosas-que-hacer-en-la-web-para-tener-mas-trafico-y-clientes/ [R=301,L]

# Imágenes del sitio Joomla: cada una a la página nueva donde se usaba (calculado con assets/origen/manifest.json)
RewriteRule ^images/blog/10\-palabras\-que\-debes\-quitar\-de\-tu\-sitio\-web\-ya\.png$ /blog/10-palabras-que-debes-quitar-de-tu-sitio-web-ya/ [R=301,L]
RewriteRule ^images/blog/5\-ideas\-para\-fortalecer\-tu\-marketing\-digital\-en\-redes\-sociales\.png$ /blog/5-ideas-para-fortalecer-tu-marketing-digital-en-redes-sociales/ [R=301,L]
RewriteRule ^images/blog/activismo\-con\-hashtags\.png$ /blog/activismo-con-hashtags/ [R=301,L]
